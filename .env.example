# Copiar a .env.local para desarrollo local.
# Los tokens de producción deben restringirse en Mapbox (Account > Access tokens):
#   https://gieihonduras.oas.org
#   https://gieihonduras.oas.org/*
# Tokens de desarrollo (separados) pueden incluir:
#   http://localhost:5173/*

# Mapa principal (cuenta ikerluna)
# VITE_MAPBOX_TOKEN=pk....

# Mapa de narrativas (cuenta representare)
# VITE_NARRATIVES_MAPBOX_TOKEN=pk....
