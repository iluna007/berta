# Copiar a .env.local para desarrollo local (archivo ignorado por git).
#
# NETLIFY (https://bertacaceresrepresentare.netlify.app/):
# Los tokens en config.js deben permitir en Mapbox:
#   https://bertacaceresrepresentare.netlify.app
#   https://bertacaceresrepresentare.netlify.app/*
#
# LOCAL (.env.local): tokens separados restringidos a:
#   http://localhost:5173/*
#
# Reiniciar `npm run dev` después de editar .env.local.
# En Netlify: push a main dispara el deploy automático (ver netlify.toml).

# VITE_MAPBOX_TOKEN=pk....token_dev_ikerluna
# VITE_NARRATIVES_MAPBOX_TOKEN=pk....token_dev_representare
